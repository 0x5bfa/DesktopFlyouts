<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows$(TargetWindowsVersion)</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<EnableMsixTooling>true</EnableMsixTooling>

		<UseWinUI>true</UseWinUI>

	</PropertyGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.WinUI.Controls.Primitives" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
		<PackageReference Include="CommunityToolkit.Mvvm" />
		<PackageReference Include="CommunityToolkit.WinUI.Controls.SettingsControls" />
		<PackageReference Include="Microsoft.Windows.CsWinRT" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DesktopFlyouts.WinUI.Projection\DesktopFlyouts.WinUI.Projection.csproj" />
	</ItemGroup>

  <ItemGroup>
    <Content Include="..\..\$(Platform)\$(Configuration)\DesktopFlyouts.WinUI\DesktopFlyouts.WinUI.dll"
             Link="DesktopFlyouts.WinUI.dll" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="..\..\src\DesktopFlyouts.WinUI\DesktopFlyouts.WinUI.vcxproj"
                      Condition="'$(BuildingSolutionFile)' != 'true'"
                      ReferenceOutputAssembly="false" SkipGetTargetFrameworkProperties="true">
      <AdditionalProperties>SolutionDir=$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\'))\</AdditionalProperties>
    </ProjectReference>
  </ItemGroup>
</Project>
