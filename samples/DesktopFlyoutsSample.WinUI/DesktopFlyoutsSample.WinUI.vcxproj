<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Label="Globals">
    <CppWinRTOptimized>true</CppWinRTOptimized>
    <CppWinRTRootNamespaceAutoMerge>true</CppWinRTRootNamespaceAutoMerge>
    <MinimalCoreWin>true</MinimalCoreWin>
    <ProjectGuid>{bb7b0d92-7b4b-4f4b-9ea2-f3a0cf2d1d4c}</ProjectGuid>
    <ProjectName>DesktopFlyoutsSample.WinUI</ProjectName>
    <RootNamespace>DesktopFlyoutsSample.WinUI</RootNamespace>
    <TargetName>DesktopFlyoutsSample.WinUI</TargetName>
    <DefaultLanguage>en-US</DefaultLanguage>
    <MinimumVisualStudioVersion>18.0</MinimumVisualStudioVersion>
    <AppContainerApplication>false</AppContainerApplication>
    <AppxPackage>true</AppxPackage>
    <EnableMsixTooling>true</EnableMsixTooling>
    <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
    <ApplicationType>Windows Store</ApplicationType>
    <ApplicationTypeRevision>10.0</ApplicationTypeRevision>
    <UseWinUI>true</UseWinUI>
    <DesktopCompatible>true</DesktopCompatible>
    <EnableNativePackageReferenceSupport>true</EnableNativePackageReferenceSupport>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <!-- The native MSIX deployment target uses this relative path when registering the F5 layout. -->
    <AppxManifestTargetPath>AppxManifest.xml</AppxManifestTargetPath>
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.26100.0</WindowsTargetPlatformVersion>
    <WindowsTargetPlatformMinVersion>10.0.19041.0</WindowsTargetPlatformMinVersion>
