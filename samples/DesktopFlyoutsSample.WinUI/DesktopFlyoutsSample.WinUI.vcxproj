    <Image Include="Assets\Square44x44Logo.scale-200.png" />
    <Image Include="Assets\StoreLogo.png" />
    <Image Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>
  <ItemGroup>
    <None Include="DesktopFlyoutsSample.WinUI.def" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="$(ProjectDir)..\..\src\DesktopFlyouts.WinUI\DesktopFlyouts.WinUI.vcxproj">
      <Project>{5b85dfce-775c-4509-a35a-63a116ec98b3}</Project>
      <Name>DesktopFlyouts.WinUI</Name>
    </ProjectReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CppWinRT" Version="$(CppWinRTVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="$(MicrosoftWindowsSDKBuildToolsNugetPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="$(MicrosoftWindowsSDKBuildToolsMsixNugetPackageVersion)" PrivateAssets="all" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="$(WindowsAppSDKRuntimeVersion)" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="$(WinUIVersion)" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />

</Project>
