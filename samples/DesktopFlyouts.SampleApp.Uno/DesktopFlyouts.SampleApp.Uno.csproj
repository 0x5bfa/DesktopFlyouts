<Project Sdk="Uno.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-desktop</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<UnoSingleProject>true</UnoSingleProject>

		<ApplicationTitle>DesktopFlyouts Uno Sample</ApplicationTitle>
		<ApplicationId>com.companyname.desktopflyouts-uno-sample</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>
		<ApplicationPublisher>DesktopFlyouts</ApplicationPublisher>
		<Description>DesktopFlyouts sample app powered by Uno Platform.</Description>

		<UnoFeatures>SkiaRenderer;</UnoFeatures>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/DesktopFlyouts.Uno/DesktopFlyouts.Uno.csproj" Condition="'$(DesktopFlyoutsPackageVersion)' == ''" />
		<PackageReference Include="DesktopFlyouts.Uno" Condition="'$(DesktopFlyoutsPackageVersion)' != ''" />
	</ItemGroup>

	<Import Project="../DesktopFlyouts.SampleApp.Shared/DesktopFlyouts.SampleApp.Shared.projitems" Label="Shared" />

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" />
	</ItemGroup>

</Project>
