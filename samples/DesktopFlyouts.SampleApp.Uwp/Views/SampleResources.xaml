<ResourceDictionary
    x:Class="DesktopFlyouts.SampleResources"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls">

    <ResourceDictionary.MergedDictionaries>
        <muxc:XamlControlsResources />
    </ResourceDictionary.MergedDictionaries>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <AcrylicBrush x:Key="FlyoutIslandBackgroundBrush" BackgroundSource="HostBackdrop" TintColor="#FF202020" TintOpacity="0.85" FallbackColor="#FF202020" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FF000000" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="FlyoutOverlayBackgroundBrush" Color="#09FFFFFF" />
            <SolidColorBrush x:Key="FlyoutSeparatorPrimaryBackgroundBrush" Color="#15FFFFFF" />
            <SolidColorBrush x:Key="FlyoutSeparatorSecondaryBackgroundBrush" Color="#18000000" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#FF2E2E2E" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF60CDFF" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#FF393D1B" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF6CCB5F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FF433519" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FFFCE100" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FF442726" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFFF99A4" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <AcrylicBrush x:Key="FlyoutIslandBackgroundBrush" BackgroundSource="HostBackdrop" TintColor="#FFF3F3F3" TintOpacity="0.85" FallbackColor="#FFF3F3F3" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="FlyoutOverlayBackgroundBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="FlyoutSeparatorPrimaryBackgroundBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="FlyoutSeparatorSecondaryBackgroundBrush" Color="#10000000" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="#FFF6F6F6" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="#FF0078D4" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="#FFDFF6DD" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="#FF0F7B0F" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="#FFFFF4CE" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="#FF9D5D00" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="#FFFDE7E9" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="#FFC42B1C" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="FlyoutIslandBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextFillColorInverseBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="FlyoutOverlayBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FlyoutSeparatorPrimaryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="FlyoutSeparatorSecondaryBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorAttentionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorSuccessBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemFillColorCautionBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorCautionBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="SystemFillColorCriticalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="OverlayCornerRadius">8</CornerRadius>
    <Style x:Key="TitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="SubtitleTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="CaptionTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>
    <Style x:Key="BodyStrongTextBlockStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
</ResourceDictionary>
