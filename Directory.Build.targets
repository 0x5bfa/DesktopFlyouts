<Project>
	<PropertyGroup>

		<!--  General properties  -->
		<Configurations>Debug;Release</Configurations>
		<Platforms>x86;x64;arm64</Platforms>
		<RuntimeIdentifiers Condition="'$(UseUwp)' == 'true' Or ('$(UseWinUI)' == 'true' And '$(UnoSingleProject)' != 'true')">win-x86;win-x64;win-arm64</RuntimeIdentifiers>

	</PropertyGroup>
	<PropertyGroup>
		<_DesktopFlyoutsWindowsPackage Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.WinUI' Or '$(MSBuildProjectName)' == 'DesktopFlyouts.Uwp'">true</_DesktopFlyoutsWindowsPackage>
	</PropertyGroup>
	<PropertyGroup Condition="'$(_DesktopFlyoutsWindowsPackage)' == 'true'">
		<!-- NU5131 compares legacy nuspec reference lists, which SDK-style RID packages do not need. -->
		<NoWarn>$(NoWarn);NU5131</NoWarn>
		<BuildOutputTargetFolder>ref</BuildOutputTargetFolder>
		<TargetsForTfmSpecificBuildOutput>$(TargetsForTfmSpecificBuildOutput);CollectWindowsReferenceFiles</TargetsForTfmSpecificBuildOutput>
		<TargetsForTfmSpecificDebugSymbolsInPackage>$(TargetsForTfmSpecificDebugSymbolsInPackage);ExcludeWindowsReferenceSymbols</TargetsForTfmSpecificDebugSymbolsInPackage>
		<TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);CollectWindowsPackageFiles</TargetsForTfmSpecificContentInPackage>
	</PropertyGroup>

	<Target Name="PackDesktopFlyoutsPackageBeforeSampleBuild"
			BeforeTargets="PrepareForBuild"
			Condition="'$(DesignTimeBuild)' != 'true' And '$(SkipDesktopFlyoutsAutoPack)' != 'true' And '$(DesktopFlyoutsPackageVersion)' != '' And
				('$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.WinUI' Or
				 '$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.Uwp' Or
				 '$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.Uno')">
		<PropertyGroup>
			<_DesktopFlyoutsPackFlavor Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.WinUI'">WinUI</_DesktopFlyoutsPackFlavor>
			<_DesktopFlyoutsPackFlavor Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.Uwp'">Uwp</_DesktopFlyoutsPackFlavor>
			<_DesktopFlyoutsPackFlavor Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.Uno'">Uno</_DesktopFlyoutsPackFlavor>
			<_DesktopFlyoutsPackageCacheId Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.WinUI'">desktopflyouts.winui</_DesktopFlyoutsPackageCacheId>
			<_DesktopFlyoutsPackageCacheId Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.Uwp'">desktopflyouts.uwp</_DesktopFlyoutsPackageCacheId>
			<_DesktopFlyoutsPackageCacheId Condition="'$(MSBuildProjectName)' == 'DesktopFlyouts.SampleApp.Uno'">desktopflyouts.uno</_DesktopFlyoutsPackageCacheId>
			<_DesktopFlyoutsPackageCacheDirectory>$([MSBuild]::NormalizeDirectory('$(NuGetPackageRoot)', '$(_DesktopFlyoutsPackageCacheId)', '$(DesktopFlyoutsPackageVersion)'))</_DesktopFlyoutsPackageCacheDirectory>
		</PropertyGroup>
		<Error Condition="'$(_DesktopFlyoutsPackFlavor)' != 'Uno' And '$(MSBuildRuntimeType)' != 'Full'"
			   Text="Use Visual Studio MSBuild to build the Windows sample with its local package." />
		<Error Condition="'$(NuGetPackageRoot)' == ''"
			   Text="NuGetPackageRoot is required to refresh the local package before building the sample." />
		<Message Importance="high" Text="Packing DesktopFlyouts.$(_DesktopFlyoutsPackFlavor) $(DesktopFlyoutsPackageVersion) (Release) before sample build." />
		<MSBuild Projects="$(MSBuildThisFileDirectory).nuget/DesktopFlyoutsPack.proj"
				 Targets="Pack"
				 BuildInParallel="false"
				 RemoveProperties="Platform;PlatformTarget;RuntimeIdentifier;TargetFramework"
				 Properties="Configuration=Release;Flavor=$(_DesktopFlyoutsPackFlavor);PackageVersion=$(DesktopFlyoutsPackageVersion);PackageOutputPath=$(DesktopFlyoutsPackageOutputPath)" />
		<RemoveDir Directories="$(_DesktopFlyoutsPackageCacheDirectory)"
				  Condition="Exists('$(_DesktopFlyoutsPackageCacheDirectory)')" />
		<Message Importance="normal" Text="Restoring DesktopFlyouts.$(_DesktopFlyoutsPackFlavor) from the freshly packed local feed." />
		<MSBuild Projects="$(MSBuildProjectFullPath)"
				 Targets="Restore"
				 BuildInParallel="false"
				 Properties="Configuration=$(Configuration);Platform=$(Platform);RuntimeIdentifier=$(RuntimeIdentifier);DesktopFlyoutsPackageVersion=$(DesktopFlyoutsPackageVersion);DesktopFlyoutsPackageOutputPath=$(DesktopFlyoutsPackageOutputPath);RestoreConfigFile=$(RestoreConfigFile);RestorePackagesPath=$(RestorePackagesPath)" />
	</Target>

	<Target Name="CollectWindowsReferenceFiles" Condition="'$(_DesktopFlyoutsWindowsPackage)' == 'true'">
		<Error Condition="'$(DesktopFlyoutsPackageRoot)' == ''"
			   Text="Use .nuget/DesktopFlyoutsPack.proj to build and pack all Windows architectures together." />
		<PropertyGroup>
			<_PackageAssemblyRoot>$(DesktopFlyoutsPackageRoot)/$(AssemblyName)</_PackageAssemblyRoot>
			<_PackageTargetFramework>$([System.Text.RegularExpressions.Regex]::Replace('$(TargetFramework)', '(windows[0-9]+\.[0-9]+\.[0-9]+)\.0$', '$1'))</_PackageTargetFramework>
		</PropertyGroup>
		<ItemGroup>
			<_PackageReference Include="$(_PackageAssemblyRoot)/reference/$(TargetFramework)/$(AssemblyName).dll" />
		</ItemGroup>
		<Error Condition="!Exists('%(_PackageReference.Identity)')" Text="Missing package reference: %(_PackageReference.Identity)" />
		<ItemGroup>
			<BuiltProjectOutputGroupOutput Remove="@(BuiltProjectOutputGroupOutput)" />
			<DocumentationProjectOutputGroupOutput Remove="@(DocumentationProjectOutputGroupOutput)" />
			<_PathToPriFile Remove="@(_PathToPriFile)" />
			<_WindowsReferenceOutput Include="@(_PackageReference);$(_PackageAssemblyRoot)/reference/$(TargetFramework)/$(AssemblyName).xml" />
			<!-- Windows XAML builds discover the library PRI beside its compile reference. -->
			<_WindowsReferenceOutput Include="$(_PackageAssemblyRoot)/x64/$(TargetFramework)/$(AssemblyName).pri" />
			<BuildOutputInPackage Include="@(_WindowsReferenceOutput)">
				<FinalOutputPath>%(_WindowsReferenceOutput.FullPath)</FinalOutputPath>
				<TargetPath>%(_WindowsReferenceOutput.Filename)%(_WindowsReferenceOutput.Extension)</TargetPath>
				<TargetFramework>$(TargetFramework)</TargetFramework>
			</BuildOutputInPackage>
		</ItemGroup>
	</Target>

	<Target Name="ExcludeWindowsReferenceSymbols" Condition="'$(_DesktopFlyoutsWindowsPackage)' == 'true'">
		<ItemGroup>
			<DebugSymbolsProjectOutputGroupOutput Remove="@(DebugSymbolsProjectOutputGroupOutput)" />
		</ItemGroup>
	</Target>

	<Target Name="CollectWindowsPackageFiles" DependsOnTargets="CollectWindowsReferenceFiles" Condition="'$(_DesktopFlyoutsWindowsPackage)' == 'true'">
		<ItemGroup>
			<_PackageArchitecture Include="x86;x64;arm64" />
			<_PackageImplementation Include="@(_PackageArchitecture->'$(_PackageAssemblyRoot)/%(Identity)/$(TargetFramework)/$(AssemblyName).dll')" />
		</ItemGroup>
		<Error Condition="!Exists('%(_PackageImplementation.Identity)')" Text="Missing package implementation: %(_PackageImplementation.Identity)" />
		<ItemGroup>
			<TfmSpecificPackageFile Include="$(_PackageAssemblyRoot)/x86/$(TargetFramework)/$(AssemblyName).dll;$(_PackageAssemblyRoot)/x86/$(TargetFramework)/$(AssemblyName).pdb"
									PackagePath="runtimes/win-x86/lib/$(_PackageTargetFramework)" />
			<TfmSpecificPackageFile Include="$(_PackageAssemblyRoot)/x64/$(TargetFramework)/$(AssemblyName).dll;$(_PackageAssemblyRoot)/x64/$(TargetFramework)/$(AssemblyName).pdb"
									PackagePath="runtimes/win-x64/lib/$(_PackageTargetFramework)" />
			<TfmSpecificPackageFile Include="$(_PackageAssemblyRoot)/arm64/$(TargetFramework)/$(AssemblyName).dll;$(_PackageAssemblyRoot)/arm64/$(TargetFramework)/$(AssemblyName).pdb"
									PackagePath="runtimes/win-arm64/lib/$(_PackageTargetFramework)" />
		</ItemGroup>
	</Target>
</Project>
