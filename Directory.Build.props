<Project>
	<PropertyGroup>

		<!--  General properties  -->
		<TargetWindowsVersion>10.0.26100.0</TargetWindowsVersion>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>
		<RootNamespace>DesktopFlyouts</RootNamespace>
		<DisableRuntimeMarshalling>true</DisableRuntimeMarshalling>
		<DefaultLanguage>en-US</DefaultLanguage>
		<!--<TreatWarningsAsErrors>true</TreatWarningsAsErrors>-->
		<CsWin32RunAsBuildTask>true</CsWin32RunAsBuildTask>

		<PublishAot>true</PublishAot>
		<!-- Native AOT has no x86 toolchain. Keep x86 applications on the JIT runtime. -->
		<PublishAot Condition="'$(Platform)' == 'x86' Or '$(PlatformTarget)' == 'x86' Or '$(RuntimeIdentifier)' == 'win-x86'">false</PublishAot>
		<AotCompatible>true</AotCompatible>

		<AppxBundle>Never</AppxBundle>

	</PropertyGroup>
</Project>
