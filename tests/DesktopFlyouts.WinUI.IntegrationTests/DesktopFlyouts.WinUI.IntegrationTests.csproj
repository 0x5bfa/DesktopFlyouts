<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<WindowsSdkPackageVersion>10.0.26100.38</WindowsSdkPackageVersion>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Platforms>x64;ARM64</Platforms>
		<RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
		<UseWinUI>true</UseWinUI>
		<WinUIDSKReferences>false</WinUIDSKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<ProjectCapability Include="TestContainer" />
		<Manifest Include="$(ApplicationManifest)" />
		<Content Include="Assets\*.png" />
		<Content Include="..\..\$(Platform)\$(Configuration)\DesktopFlyouts.WinUI\DesktopFlyouts.WinUI.dll" Link="DesktopFlyouts.WinUI.dll" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.TestPlatform.TestHost" Version="18.10.1" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
		<PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
		<PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\src\DesktopFlyouts.WinUI.Projection\DesktopFlyouts.WinUI.Projection.csproj" />
	</ItemGroup>

</Project>
