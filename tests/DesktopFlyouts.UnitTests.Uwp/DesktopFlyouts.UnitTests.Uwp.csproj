<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows$(TargetWindowsVersion)</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>

		<!--  Uwp config  -->
		<UseUwp>true</UseUwp>
		<UseUwpTools>true</UseUwpTools>
		<DisableEmbeddedXbf>false</DisableEmbeddedXbf>
		<EnableMsixTooling>true</EnableMsixTooling>

		<!--  Test config  -->
		<IsTestProject>true</IsTestProject>
		<GenerateProgramFile>false</GenerateProgramFile>

	</PropertyGroup>

	<ItemGroup>
		<ProjectCapability Include="TestContainer" />
		<Content Include="Assets\**" />
		<!-- Preserve the AOT marshalling regression checks in the template's app host. -->
		<RuntimeHostConfigurationOption Include="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" Value="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/DesktopFlyouts.Uwp/DesktopFlyouts.Uwp.csproj" />
		<!-- This ABI regression test also covers the actual sample collection declaration. -->
		<Compile Include="../../samples/DesktopFlyouts.SampleApp.Shared/SampleIslandData.cs" Link="Sample/SampleIslandData.cs" />
	</ItemGroup>

	<Import Project="../DesktopFlyouts.UnitTests.Shared/DesktopFlyouts.UnitTests.Shared.projitems" Label="Shared" />

</Project>
