<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
		<UseUwp>true</UseUwp>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
	</PropertyGroup>

	<ItemGroup>
		<!-- Match the samples' AOT feature switch without creating a XAML application. -->
		<RuntimeHostConfigurationOption Include="System.Runtime.CompilerServices.RuntimeFeature.IsDynamicCodeSupported" Value="false" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="Microsoft.VCRTForwarders.140" />
		<PackageReference Include="Win2D.uwp" GeneratePathProperty="true" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/DesktopFlyouts.Uwp/DesktopFlyouts.Uwp.csproj" />
		<Compile Include="../../samples/DesktopFlyouts.SampleApp.Shared/SampleIslandData.cs" Link="Production/SampleIslandData.cs" />
		<Compile Include="../../src/DesktopFlyouts.Uwp/DesktopFlyoutAcrylicEffect.cs" Link="Production/DesktopFlyoutAcrylicEffect.cs" />
		<Compile Include="../../src/DesktopFlyouts.Uwp/DesktopFlyoutMicaEffect.cs" Link="Production/DesktopFlyoutMicaEffect.cs" />
		<!-- VSTest has no MSIX activation context. Keep Win2D beside the test host for CsWinRT activation. -->
		<Content Include="$(PkgWin2D_uwp)/runtimes/win-$(Platform)/native/Microsoft.Graphics.Canvas.dll"
				 Link="Microsoft.Graphics.Canvas.dll" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>

</Project>
