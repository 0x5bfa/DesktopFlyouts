<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>

		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows$(TargetWindowsVersion)</TargetFramework>
		<TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<PublishProfile>win-$(Platform).pubxml</PublishProfile>
		<RuntimeIdentifier>win-$(Platform)</RuntimeIdentifier>

		<!--  WinUI config  -->
		<UseWinUI>true</UseWinUI>
		<WinUISDKReferences>false</WinUISDKReferences>
		<EnableMsixTooling>true</EnableMsixTooling>

		<!--  Test config  -->
		<IsTestProject>true</IsTestProject>
		<GenerateProgramFile>false</GenerateProgramFile>

	</PropertyGroup>

	<ItemGroup>
		<Manifest Include="$(ApplicationManifest)" />
		<Page Remove="UnitTestApp.xaml" />
		<ApplicationDefinition Include="UnitTestApp.xaml" />
		<ProjectCapability Include="TestContainer" />
		<ProjectCapability Include="Msix" />
		<Content Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.TestPlatform.TestHost" />
		<PackageReference Include="MSTest.TestAdapter" />
		<PackageReference Include="MSTest.TestFramework" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" />
		<PackageReference Include="Microsoft.WindowsAppSDK.Runtime" />
		<PackageReference Include="Microsoft.WindowsAppSDK.WinUI" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../../src/DesktopFlyouts.WinUI/DesktopFlyouts.WinUI.csproj" />
	</ItemGroup>

	<Import Project="../DesktopFlyouts.UnitTests.Shared/DesktopFlyouts.UnitTests.Shared.projitems" Label="Shared" />

</Project>
