root = true

[*]
charset = utf-8
end_of_line = crlf
insert_final_newline = true
indent_style = space
indent_size = 4

[*.cs]
indent_style = tab
indent_size = 4
tab_width = 4
file_header_template = Copyright (c) 0x5BFA. All rights reserved.\r\nLicensed under the MIT license.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0073.severity = error

[*.appxmanifest]
charset = utf-8-bom
