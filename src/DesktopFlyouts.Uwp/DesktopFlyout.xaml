<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DesktopFlyouts">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="DesktopFlyoutIslandBorderBrush" Color="{ThemeResource SurfaceStrokeColorDefault}" />
            <Thickness x:Key="DesktopFlyoutIslandBorderThickness">1,1,1,1</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="DesktopFlyoutIslandBorderBrush" Color="{ThemeResource SurfaceStrokeColorDefault}" />
            <Thickness x:Key="DesktopFlyoutIslandBorderThickness">1,1,1,1</Thickness>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="DesktopFlyoutIslandBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <Thickness x:Key="DesktopFlyoutIslandBorderThickness">2,2,2,2</Thickness>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="DesktopFlyoutIslandContentPresenterStyle" TargetType="ContentPresenter" />

    <ControlTemplate x:Key="DesktopFlyoutPresenterTemplate" TargetType="ItemsControl">
        <Grid x:Name="PART_RootGrid" TabFocusNavigation="Cycle">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <ItemsPresenter x:Name="PART_ItemsPresenter" />
            </ScrollViewer>
        </Grid>
    </ControlTemplate>

    <ItemsPanelTemplate x:Key="DesktopFlyoutItemsPanel">
        <local:DesktopFlyoutIslandsPanel />
    </ItemsPanelTemplate>

    <Style x:Key="DesktopFlyoutPresenterStyle" TargetType="ItemsControl">
        <Setter Property="Template" Value="{StaticResource DesktopFlyoutPresenterTemplate}" />
        <Setter Property="ItemsPanel" Value="{StaticResource DesktopFlyoutItemsPanel}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <ControlTemplate x:Key="DesktopFlyoutIslandTemplate" TargetType="ContentControl">
        <Grid
            x:Name="PART_RootGrid"
            BorderBrush="{ThemeResource DesktopFlyoutIslandBorderBrush}"
            BorderThickness="{ThemeResource DesktopFlyoutIslandBorderThickness}"
            CornerRadius="{StaticResource OverlayCornerRadius}"
            Style="{x:Null}"
            Translation="0,0,36">
            <Grid.Shadow>
                <ThemeShadow />
            </Grid.Shadow>
            <ContentPresenter
                x:Name="PART_MainContentPresenter"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                BorderBrush="Transparent"
                BorderThickness="0"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                CornerRadius="7"
                Style="{StaticResource DesktopFlyoutIslandContentPresenterStyle}" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultWindows11DesktopMenuFlyoutStyle" TargetType="local:DesktopMenuFlyout">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DesktopMenuFlyout">
                    <Grid
                        x:Name="PART_RootGrid"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Border x:Name="PART_MenuFlyoutTargetControl" Background="Transparent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style BasedOn="{StaticResource DefaultWindows11DesktopMenuFlyoutStyle}" TargetType="local:DesktopMenuFlyout" />


</ResourceDictionary>
