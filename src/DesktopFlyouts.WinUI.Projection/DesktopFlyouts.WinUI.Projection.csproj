<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64;arm64</Platforms>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <CsWinRTIncludes>DesktopFlyouts</CsWinRTIncludes>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NativePlatform Condition="'$(Platform)' == 'arm64'">ARM64</NativePlatform>
    <NativePlatform Condition="'$(Platform)' != 'arm64'">x64</NativePlatform>
    <NativeProject>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', 'DesktopFlyouts.WinUI', 'DesktopFlyouts.WinUI.vcxproj'))</NativeProject>
    <NativeOutDir>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '..', '..', '$(NativePlatform)', '$(Configuration)', 'DesktopFlyouts.WinUI'))\</NativeOutDir>
    <NativeWinMD>$(NativeOutDir)DesktopFlyouts.winmd</NativeWinMD>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.3.1" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <CsWinRTInputs Include="$(NativeWinMD)" />
  </ItemGroup>

  <Target Name="BuildNativeProjectionInput" BeforeTargets="CsWinRTGenerateProjection" Condition="'$(DesignTimeBuild)' != 'true' and '$(BuildingSolutionFile)' != 'true'">
    <MSBuild Projects="$(NativeProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);Platform=$(NativePlatform);OutDir=$(NativeOutDir)" />
  </Target>

</Project>
