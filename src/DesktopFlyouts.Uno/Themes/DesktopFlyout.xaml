<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DesktopFlyouts">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <Style x:Key="DesktopFlyoutIslandChromeStyle" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,1" />
            </Style>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <Style x:Key="DesktopFlyoutIslandChromeStyle" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource SurfaceStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,1" />
            </Style>
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <Style x:Key="DesktopFlyoutIslandChromeStyle" TargetType="Grid">
                <Setter Property="BorderBrush" Value="{ThemeResource SystemColorWindowTextColorBrush}" />
                <Setter Property="BorderThickness" Value="2,2,2,2" />
            </Style>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <ControlTemplate x:Key="DesktopFlyoutPresenterTemplate" TargetType="ItemsControl">
        <Grid
            x:Name="PART_RootGrid"
            RenderTransformOrigin="0.5,0.5"
            TabFocusNavigation="Cycle">
            <ScrollViewer
                x:Name="PART_ScrollViewer"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <ItemsPresenter x:Name="PART_ItemsPresenter" />
            </ScrollViewer>
        </Grid>
    </ControlTemplate>

    <ItemsPanelTemplate x:Key="DesktopFlyoutItemsPanel">
        <local:DesktopFlyoutIslandsPanel />
    </ItemsPanelTemplate>

    <ControlTemplate x:Key="DesktopFlyoutIslandTemplate" TargetType="ContentControl">
        <Grid
            x:Name="PART_RootGrid"
            Style="{ThemeResource DesktopFlyoutIslandChromeStyle}"
            CornerRadius="8">
            <ContentPresenter
                x:Name="PART_MainContentPresenter"
                Margin="0"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch"
                Content="{TemplateBinding Content}"
                ContentTemplate="{TemplateBinding ContentTemplate}"
                ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                CornerRadius="7" />
        </Grid>
    </ControlTemplate>

    <Style x:Key="DefaultWindows11DesktopMenuFlyoutStyle" TargetType="local:DesktopMenuFlyout">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DesktopMenuFlyout">
                    <Grid
                        x:Name="PART_RootGrid"
                        Background="Transparent"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid x:Name="PART_MenuFlyoutTargetControl" Background="Transparent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <Style BasedOn="{StaticResource DefaultWindows11DesktopMenuFlyoutStyle}" TargetType="local:DesktopMenuFlyout" />

</ResourceDictionary>
